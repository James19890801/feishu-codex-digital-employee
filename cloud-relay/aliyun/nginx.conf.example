# Install only as a new independent virtual host after issuing its certificate.
server {
    listen 80;
    server_name wxrelay.e2eskill.cn;
    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    server_name wxrelay.e2eskill.cn;
    ssl_certificate /etc/letsencrypt/live/wxrelay.e2eskill.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wxrelay.e2eskill.cn/privkey.pem;
    client_max_body_size 26m;
    access_log off;

    location / {
        proxy_pass http://127.0.0.1:17658;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
    }
}

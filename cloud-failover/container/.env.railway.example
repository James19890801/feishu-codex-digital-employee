# Optional override: omit both values to use CONNECTOR built-in device OAuth.
# ENTERPRISE_CHAT_CLIENT_ID=<dedicated-cloud-app-id>
# ENTERPRISE_CHAT_CLIENT_SECRET=<sealed-service-secret>
ENTERPRISE_CHAT_CONNECTOR_AUTH_BUNDLE_B64=<dedicated-cloud-auth-export>
AIPROS_CLOUD_CONNECTOR_CHANNEL=<registered-digital-human-channel-code>
AIPROS_CONNECTOR_HOME=/data/connector-home
AIPROS_COORDINATOR_URL=https://aipros-cloud-failover.example.workers.dev
AIPROS_CONTAINER_TOKEN=<independent-random-token>
AIPROS_ALLOWED_CHAT_IDS=<comma-separated-chat-ids>
AIPROS_ALLOWED_SENDER_IDS=<comma-separated-user-ids>
RAILWAY_RUN_UID=0
PORT=8788
